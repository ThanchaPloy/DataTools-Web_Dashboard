    <worksheet name='ลูกค้ารอโทรตามคะแนน ML'>
      <table>
        <view>
          <datasources>
            <datasource caption='ลูกค้า (bank_data)' name='federated.bank_call_tracker' />
          </datasources>
          <datasource-dependencies datasource='federated.bank_call_tracker'>
            <column caption='รอโทร (คน)' datatype='integer' default-format='n#,##0' name='[Calculation_pending]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([y]=&apos;pending&apos;,1,0)' />
            </column>
            <column caption='ระดับคะแนน ML' datatype='string' name='[Calculation_score]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([prob_yes]) THEN &apos;4 ยังไม่มีคะแนน&apos; ELSEIF [prob_yes] &gt;= 0.5 THEN &apos;1 สูง (≥ 50%)&apos; ELSEIF [prob_yes] &gt;= 0.2 THEN &apos;2 กลาง (20-50%)&apos; ELSE &apos;3 ต่ำ (&lt; 20%)&apos; END' />
            </column>
            <column-instance column='[Calculation_score]' derivation='None' name='[none:Calculation_score:nk]' pivot='key' type='nominal' />
            <column caption='โอกาสตอบรับ (ML)' datatype='real' name='[prob_yes]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_pending]' derivation='Sum' name='[sum:Calculation_pending:qk]' pivot='key' type='quantitative' />
            <column caption='ผลการโทร' datatype='string' name='[y]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <text column='[federated.bank_call_tracker].[sum:Calculation_pending:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.bank_call_tracker].[none:Calculation_score:nk]</rows>
        <cols>[federated.bank_call_tracker].[sum:Calculation_pending:qk]</cols>
      </table>
      <simple-id uuid='{8D2D85A6-BCA7-4571-8FE9-2FAD47401F25}' />
    </worksheet>
    <worksheet name='สถานะลูกค้า'>
      <table>
        <view>
          <datasources>
            <datasource caption='ลูกค้า (bank_data)' name='federated.bank_call_tracker' />
          </datasources>
          <datasource-dependencies datasource='federated.bank_call_tracker'>
            <column caption='สถานะลูกค้า' datatype='string' name='[Calculation_status]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [y] WHEN &apos;yes&apos; THEN &apos;ตอบรับ&apos; WHEN &apos;no&apos; THEN &apos;ไม่ตอบรับ&apos; ELSE &apos;รอโทร&apos; END' />
            </column>
            <column-instance column='[customer_id]' derivation='Count' name='[cnt:customer_id:qk]' pivot='key' type='quantitative' />
            <column caption='รหัสลูกค้า' datatype='string' name='[customer_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_status]' derivation='None' name='[none:Calculation_status:nk]' pivot='key' type='nominal' />
            <column caption='ผลการโทร' datatype='string' name='[y]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
