    <worksheet name='อัตราตอบรับรายเดือน'>
      <table>
        <view>
          <datasources>
            <datasource caption='ลูกค้า (bank_data)' name='federated.bank_call_tracker' />
          </datasources>
          <datasource-dependencies datasource='federated.bank_call_tracker'>
            <column caption='อัตราตอบรับ' datatype='real' default-format='p0.0%' name='[Calculation_conv]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([y]=&apos;yes&apos;,1,0)) / SUM(IIF([y]=&apos;yes&apos; OR [y]=&apos;no&apos;,1,0))' />
            </column>
            <column caption='เดือน (เรียงลำดับ)' datatype='string' name='[Calculation_month]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [month] WHEN &apos;jan&apos; THEN &apos;01 ม.ค.&apos; WHEN &apos;feb&apos; THEN &apos;02 ก.พ.&apos; WHEN &apos;mar&apos; THEN &apos;03 มี.ค.&apos; WHEN &apos;apr&apos; THEN &apos;04 เม.ย.&apos; WHEN &apos;may&apos; THEN &apos;05 พ.ค.&apos; WHEN &apos;jun&apos; THEN &apos;06 มิ.ย.&apos; WHEN &apos;jul&apos; THEN &apos;07 ก.ค.&apos; WHEN &apos;aug&apos; THEN &apos;08 ส.ค.&apos; WHEN &apos;sep&apos; THEN &apos;09 ก.ย.&apos; WHEN &apos;oct&apos; THEN &apos;10 ต.ค.&apos; WHEN &apos;nov&apos; THEN &apos;11 พ.ย.&apos; WHEN &apos;dec&apos; THEN &apos;12 ธ.ค.&apos; END' />
            </column>
            <column caption='เดือน' datatype='string' name='[month]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_month]' derivation='None' name='[none:Calculation_month:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_conv]' derivation='User' name='[usr:Calculation_conv:qk]' pivot='key' type='quantitative' />
            <column caption='ผลการโทร' datatype='string' name='[y]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
            <encodings>
              <text column='[federated.bank_call_tracker].[usr:Calculation_conv:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.bank_call_tracker].[usr:Calculation_conv:qk]</rows>
        <cols>[federated.bank_call_tracker].[none:Calculation_month:nk]</cols>
      </table>
      <simple-id uuid='{8D93D33D-A2A6-45E7-80DA-023CB91B1090}' />
    </worksheet>
