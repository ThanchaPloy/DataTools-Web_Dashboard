            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.bank_call_tracker].[none:Calculation_status:nk]' />
              <text column='[federated.bank_call_tracker].[cnt:customer_id:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.bank_call_tracker].[none:Calculation_status:nk]</rows>
        <cols>[federated.bank_call_tracker].[cnt:customer_id:qk]</cols>
