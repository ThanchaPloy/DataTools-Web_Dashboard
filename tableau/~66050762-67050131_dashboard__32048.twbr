    <worksheet name='อัตราตอบรับตามกลุ่มอายุ'>
      <table>
        <view>
          <datasources>
            <datasource caption='ลูกค้า (bank_data)' name='federated.bank_call_tracker' />
          </datasources>
          <datasource-dependencies datasource='federated.bank_call_tracker'>
            <column caption='กลุ่มอายุ' datatype='string' name='[Calculation_agegroup]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [age] &lt; 30 THEN &apos;17-29&apos; ELSEIF [age] &lt; 40 THEN &apos;30-39&apos; ELSEIF [age] &lt; 50 THEN &apos;40-49&apos; ELSEIF [age] &lt; 60 THEN &apos;50-59&apos; ELSE &apos;60+&apos; END' />
            </column>
            <column caption='อัตราตอบรับ' datatype='real' default-format='p0.0%' name='[Calculation_conv]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([y]=&apos;yes&apos;,1,0)) / SUM(IIF([y]=&apos;yes&apos; OR [y]=&apos;no&apos;,1,0))' />
            </column>
            <column caption='อายุ' datatype='integer' name='[age]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_agegroup]' derivation='None' name='[none:Calculation_agegroup:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_conv]' derivation='User' name='[usr:Calculation_conv:qk]' pivot='key' type='quantitative' />
            <column caption='ผลการโทร' datatype='string' name='[y]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <text column='[federated.bank_call_tracker].[usr:Calculation_conv:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.bank_call_tracker].[usr:Calculation_conv:qk]</rows>
        <cols>[federated.bank_call_tracker].[none:Calculation_agegroup:nk]</cols>
      </table>
      <simple-id uuid='{7C07B386-B210-4014-9DE7-7C1CBDF746C1}' />
    </worksheet>
    <worksheet name='อัตราตอบรับตามอาชีพ'>
      <table>
