      <aliases enabled='yes' />
      <column caption='กลุ่มอายุ' datatype='string' name='[Calculation_agegroup]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &lt; 30 THEN &apos;17-29&apos; ELSEIF [age] &lt; 40 THEN &apos;30-39&apos; ELSEIF [age] &lt; 50 THEN &apos;40-49&apos; ELSEIF [age] &lt; 60 THEN &apos;50-59&apos; ELSE &apos;60+&apos; END' />
      </column>
      <column caption='โทรแล้ว (คน)' datatype='integer' default-format='n#,##0' name='[Calculation_called]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([y]=&apos;yes&apos; OR [y]=&apos;no&apos;,1,0)' />
      </column>
      <column caption='อัตราตอบรับ' datatype='real' default-format='p0.0%' name='[Calculation_conv]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([y]=&apos;yes&apos;,1,0)) / SUM(IIF([y]=&apos;yes&apos; OR [y]=&apos;no&apos;,1,0))' />
      </column>
      <column caption='เดือน (เรียงลำดับ)' datatype='string' name='[Calculation_month]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [month] WHEN &apos;jan&apos; THEN &apos;01 ม.ค.&apos; WHEN &apos;feb&apos; THEN &apos;02 ก.พ.&apos; WHEN &apos;mar&apos; THEN &apos;03 มี.ค.&apos; WHEN &apos;apr&apos; THEN &apos;04 เม.ย.&apos; WHEN &apos;may&apos; THEN &apos;05 พ.ค.&apos; WHEN &apos;jun&apos; THEN &apos;06 มิ.ย.&apos; WHEN &apos;jul&apos; THEN &apos;07 ก.ค.&apos; WHEN &apos;aug&apos; THEN &apos;08 ส.ค.&apos; WHEN &apos;sep&apos; THEN &apos;09 ก.ย.&apos; WHEN &apos;oct&apos; THEN &apos;10 ต.ค.&apos; WHEN &apos;nov&apos; THEN &apos;11 พ.ย.&apos; WHEN &apos;dec&apos; THEN &apos;12 ธ.ค.&apos; END' />
      </column>
      <column caption='รอโทร (คน)' datatype='integer' default-format='n#,##0' name='[Calculation_pending]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([y]=&apos;pending&apos;,1,0)' />
      </column>
      <column caption='ระดับคะแนน ML' datatype='string' name='[Calculation_score]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([prob_yes]) THEN &apos;4 ยังไม่มีคะแนน&apos; ELSEIF [prob_yes] &gt;= 0.5 THEN &apos;1 สูง (≥ 50%)&apos; ELSEIF [prob_yes] &gt;= 0.2 THEN &apos;2 กลาง (20-50%)&apos; ELSE &apos;3 ต่ำ (&lt; 20%)&apos; END' />
      </column>
      <column caption='สถานะลูกค้า' datatype='string' name='[Calculation_status]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [y] WHEN &apos;yes&apos; THEN &apos;ตอบรับ&apos; WHEN &apos;no&apos; THEN &apos;ไม่ตอบรับ&apos; ELSE &apos;รอโทร&apos; END' />
      </column>
      <column caption='ตอบรับ (คน)' datatype='integer' default-format='n#,##0' name='[Calculation_yes]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([y]=&apos;yes&apos;,1,0)' />
      </column>
      <column caption='Migrated Data' datatype='table' name='[__tableau_internal_object_id__].[Migrated Data]' role='measure' type='quantitative' />
