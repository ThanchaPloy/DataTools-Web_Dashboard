          <datasources><datasource caption='ลูกค้า (bank_data)' name='federated.bank_call_tracker' /></datasources>
          <datasource-dependencies datasource='federated.bank_call_tracker'><column caption="ผลการโทร" datatype='string' name='[y]' role='dimension' type='nominal' /><column caption="โทรแล้ว (คน)" datatype='integer' default-format="n#,##0" name='[Calculation_called]' role='measure' type='quantitative'><calculation class='tableau' formula="IIF([y]='yes' OR [y]='no',1,0)" /></column><column-instance column='[Calculation_called]' derivation='Sum' name='[sum:Calculation_called:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <encodings><text column='[federated.bank_call_tracker].[sum:Calculation_called:qk]' /></encodings>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
